# Generate the real private file with scripts/configure_hosted.py. Never commit it.
DOMAIN=replace-with-owned-domain.invalid
ACME_EMAIL=owner@example.invalid
USERS_FILE=/etc/eraseproof/users.json
DASHBOARD_PUBLIC_DEMO=0
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32_BYTE_SECRET
RUNTIME_DB_PASSWORD=REPLACE_WITH_RANDOM_32_BYTE_SECRET
RABBITMQ_PASSWORD=REPLACE_WITH_RANDOM_32_BYTE_SECRET
REDIS_PASSWORD=REPLACE_WITH_RANDOM_32_BYTE_SECRET
INSPECTION_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_SECRET
OPERATOR_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_SECRET
DELETION_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_SECRET
VERIFICATION_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_SECRET
RESEARCH_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_SECRET
VERIFIER_DB_PASSWORD=REPLACE_WITH_RANDOM_32_BYTE_SECRET
VERIFIER_CONTROL_PASSWORD=REPLACE_WITH_RANDOM_32_BYTE_SECRET
VERIFIER_REDIS_PASSWORD=REPLACE_WITH_RANDOM_32_BYTE_SECRET
MIGRATOR_DATABASE_URL=postgresql://lab:REPLACE@postgres:5432/eraseproof
RUNTIME_DATABASE_URL=postgresql://eraseproof_runtime:REPLACE@postgres:5432/eraseproof
VERIFIER_CONTROL_DATABASE_URL=postgresql://verification_coordinator:REPLACE@postgres:5432/eraseproof
VERIFIER_READ_DATABASE_URL=postgresql://verification_probe:REPLACE@postgres:5432/eraseproof
BROKER_URL=amqp://lab:REPLACE@rabbitmq:5672/%2F
REDIS_URL=redis://:REPLACE@redis:6379/0
VERIFIER_REDIS_URL=redis://verification:REPLACE@redis:6379/0

VERIFIER_SEARCH_PASSWORD=REPLACE_WITH_RANDOM_32_BYTE_SECRET
VERIFIER_SEARCH_URL=http://verification:REPLACE@search-reader:9200
